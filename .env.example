# Site origin used for canonical URLs, sitemap, RSS, embeds, etc.
# Defaults to https://madebyhuman.iamjarl.com if unset.
NEXT_PUBLIC_SITE_ORIGIN=https://madebyhuman.iamjarl.com

# Umami analytics, privacy-respecting and EU-friendly.
# Honors Do Not Track and only tracks traffic from data-domains (set in layout.tsx).
# Override these if you're running your own Umami instance (e.g. a fork).
NEXT_PUBLIC_UMAMI_SRC=https://umami-iamjarl.vercel.app/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=a8ee647d-8843-48d5-8cbc-33224e12ad61
